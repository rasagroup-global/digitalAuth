# ═══════════════════════════════════════════════════════════════════════════════
# Rasa SSO (Keycloak 26) — Environment Configuration
# Repository: https://github.com/rasagroup-global/digitalAuth
# ═══════════════════════════════════════════════════════════════════════════════

PROJECT_NAME=sso-dev
DOCKER_TAG=26.0

# Keycloak Admin Console Bootstrap Credentials
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=ChangeMeStrongAdminPassword123!

# Public Hostname (https://sso-dev.rasagroup.global or https://sso.rasagroup.global)
KC_HOSTNAME=https://sso-dev.rasagroup.global
KC_HOSTNAME_STRICT=false
KC_HTTP_ENABLED=true
KC_PROXY_HEADERS=xforwarded
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true

# Database Configuration (PostgreSQL — api-shared-db on VPS or keycloak-db locally)
KC_DB=postgres
KC_DB_URL_HOST=api-shared-db
KC_DB_URL_PORT=5432
KC_DB_URL_DATABASE=keycloak_db
KC_DB_USERNAME=postgres
KC_DB_PASSWORD=ChangeMeDbPassword123!

# Realm & OIDC Client Secrets (Used in rasa-realm.json via env substitution)
KEYCLOAK_REALM=rasa
KEYCLOAK_API_CLIENT_SECRET=rasa-api-secret-dev-2026
KEYCLOAK_CMS_CLIENT_SECRET=rasa-cms-secret-dev-2026
KEYCLOAK_COMMERCE_CLIENT_SECRET=rasa-commerce-secret-dev-2026

# Google OAuth 2.0 Identity Provider (Social Login on Keycloak)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# JVM Memory Tuning for VPS Container
JAVA_OPTS_APPEND=-Xms256m -Xmx640m -XX:MetaspaceSize=96M -XX:MaxMetaspaceSize=256m
