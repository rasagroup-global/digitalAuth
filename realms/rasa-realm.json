        "https://api-staging.rasagroup.global/*",
        "https://api.rasagroup.global/*",
        "http://localhost:8000/*",
        "http://127.0.0.1:8000/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "rasa_uuid",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "rasa_uuid",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "rasa_uuid",
            "jsonType.label": "String"
          }
        },
